   issue = {5},
   journal = {International Politics},
   keywords = {1648,capitalism,evolution and expansion of,geopolitics,historical sociology,in ir theory,interstate system,ir theory,marxism,problems and perspectives,situating,studies on the origins,the paucity of substantive,westphalia},
