@techReport{,
   abstract = {Executive summary ❖ National Security priorities now dominate European energy policy, profoundly changing the approach and incentives for policy makers promoting "Freedom-energy" and pursuing strategic autonomy ❖ European Commission proposals promote the goal of a two thirds reduction in Russian gas imports by end 2022. ❖ Leaders call for more actionable Commission proposals on top of the Fit for 55 program, focusing on gas storage, electrification and permitting. ❖ The task is enormous; if the rate of renewables deployments per year was increased five-fold, it would take until 2025 to fully replace Russian gas. ❖ Coal and nuclear energy are not mentioned in the Communication to avoid controversy but will contribute as substitutes. New targets on bio-methane and hydrogen production and imports are set but will be difficult to achieve ❖ With record energy prices, expansion of the ETS will not occur and, while the CBAM will be formulated, it will not be implemented ❖ Active industrial policy will come to the fore. As illustrated by RePower EU, measures focusing on state aid, energy independence and strategic autonomy. Supply chains for renewables and reliance on producers like China are contentious and will become a key focus ❖ The energy and policy mix will be decided at national level, not by the EU. Measures will be dictated by member state choices while they seek to promote flexibility at European policy levels ❖ The Commission will review the electricity market design. Proposal expected Mid-May. By end March a plan to ensure security of supply of energy will be proposed, and in April legislation on gas storage. Member states will employ windfall taxing of profits from the inflated energy market ❖ We expect the energy crisis to spill over to other policy areas. This will mean pressure for prolonged leniency in the Stability and Growth Pact and calls for a new round of joint borrowing to alleviate immediate effects and invest in long term solutions. These types of "grand bargains" may deliver unprecedented European collective action in energy and industrial policy},
   title = {Freedom energy in the EU-getting to Russian gas independence},
   year = {2022}
}
@techReport{,
   abstract = {The plan sets a minimum requirement for new power generation capacity (800GW over a five-year period), in which hydropower and nuclear constitute only a marginal 8%, the rest made up of wind, solar, biomass and fossil energy installations. Although China has recently approved some new coal power projects and a few existing power plants will undergo capacity expansion to match large-scale renewable installation for grid security, it is unlikely that new installations of coal power capacity in the 14FYP will be comparable to the vast expansion of wind and solar. In brief, non-fossil energy sources will constitute the largest portion of newly installed capacity in the 14FYP, which aligns with Xi Jinping's vision of a power system in which clean energy sources dominate. Specifically, the plan aims to increase non-fossil power to 39% of China's energy mix by 2035. Multiple measures have been put place to prepare the medium-and long-term transition within the 14FYP, including further improving electrification rates by 3.5 percentage points, non-fossil power generation by 7 percentage points, and accelerate the installation of flexible power sources such as pumped-hydro, flexible coal-and gas-fired units. It is worth noting that these targets are also the minimum requirements to meet the targets set in China's Nationally Determined Contribution (NDC). That said, targets may be overshot, especially those regarding wind and solar. As a final note, the plan includes a citation of Xi Jinping's announcement before COP26 on China's ambitions to step up clean energy cooperation and ending overseas coal power projects-this is the first time the ambition has been written in official domestic policy. Medium-and-long-term plan on hydrogen development (2021-2035) This plan is part of China's "1+N" policy framework for peaking carbon emissions and achieving carbon neutrality, known as the dual-carbon goals. This is the first medium-and-long-term plan on a specific energy source since Xi Jinping announced the dual-carbon pledge in 2020. The plan emphasises the importance of hydrogen in China's future energy system, comparable to electricity as a low-carbon secondary energy.},
   title = {Title Kaya Research Private and Confidential 2}
}
@techReport{,
   abstract = {The first victim of war might be the truth, but this one has also dispelled a delusion-namely that Europe's increasing reliance on Russian gas up to and after 2014 was ever a sound basis for energy security. European imports of Russian gas, arriving by fixed pipelines and under long term contracts, now hold the continent's economy to ransom. That Russian gas imports to Europe grew since the annexation of Crimea in 2014, from 37 per cent to 47 per cent of the total, shows how economics took priority over security in European energy policy. Ending this dependency will mean serious short-term disruption. Europe has embarked on an emergency program to replace Russian gas now constituting 25% of its total consumption. The result is an energy crisis so severe it is second only to the risk of direct Nato-Russian conflict as a priority for western politicians. Replacing Russian gas is not just a tall order. Our analysis shows it is impossible without reduced demand through economic damage; alternative supplies of energy from all sources; and a willingness to meet any cost from the public purse. The main alternatives to Russian gas are gas piped from Norway and North Africa, liquified natural gas (LNG) sourced on the open market, a reversion to coal, delayed closure of nuclear plants and new renewable capacity.-In the short term, replacing cleaner gas with dirtier fuel oil in thermal generation is inevitable, and the reversal in the long-term decline in coal generation seen in 2021 will be repeated. Both will add emissions intensity to the energy mix, although net emissions could fall along with demand.-Europe pivots away from Russia and buys up LNG supplies wherever it can find them quickly. The likeliest beneficiary will be shale gas exporters in the US. Shale deposits},
   title = {How National Security is Going to Run the Energy Transition},
   url = {https://www.tortoisemedia.com/2022/03/08/how-national-security-is-going-to-run-}
}
