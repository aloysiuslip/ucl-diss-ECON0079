{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Mount Google Drive",
            "type": "shell",
            "command": "sudo mount -t drvfs H: /mnt/h",
            "windows": {
                "command": "sudo mount -t drvfs H: /mnt/h"
            },
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "runOptions": {
                "runOn": "default" // manual trigger,
            }
        },
        {
            "label": "Load pydynpd venv",
            "type": "shell",
            "windows": {
                "command": "source .venv/Scripts/activate"
            },
            "linux": {
                "command": "source .venv/bin/activate"
            },
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "runOptions": {
                "runOn": "default" // manual trigger,
            }
        }
    ]
}