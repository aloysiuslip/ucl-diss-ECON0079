{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Mount Google Drive",
            "type": "shell",
            "command": "sudo mount -t drvfs H: /mnt/h",
            "windows": {
                "command": "sudo mount -t drvfs H: /mnt/h"
            },
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "runOptions": {
                "runOn": "default" // manual trigger,
            }
        },
        {
            "label": "Load pydynpd venv",
            "type": "shell",
            "windows": {
                "command": "source .venv/Scripts/activate"
            },
            "linux": {
                "command": "source .venv/bin/activate"
            },
            "group": "none",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "runOptions": {
                "runOn": "default" // manual trigger,
            }
        },
        {
            "label": "Count tex countable",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/tex/writing",
                "shell": {
                    "executable": "powershell.exe",
                    "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]
                }
            },
            "windows": {
                "command": "$raw = (texcount -inc -sum -merge -q -dir=. -template='{sum}' 1_countable.tex 2>$null | Out-String); $num = [regex]::Match($raw, '\\d+').Value; $formatted = '{0:N0}' -f [int]$num; Set-Content -Path components/wordcount.tex -Value $formatted -Encoding Ascii; $formatted"
            },
            "linux": {
                "command": "raw=$(texcount -inc -sum -merge -q -dir=. -template='{sum}' 1_countable.tex 2>/dev/null | grep -o '[0-9]\\+'); formatted=$(printf \"%'d\" $raw); echo $formatted > components/wordcount.tex; echo $formatted"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true,
                "focus": false
            },
            "problemMatcher": []
        },
        {
            "label": "Count tex all",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/tex/writing"
            },
            "windows": {
                "command": "texcount -inc -sum -merge -dir=. -brief 0_main.tex"
            },
            "linux": {
                "command": "texcount -inc -sum -merge -dir=. -brief 0_main.tex"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true,
                "focus": false
            },
            "problemMatcher": []
        },
        {
            "label": "Count PDF words",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}/tex/writing"
            },
            "windows": {
                "command": "pdftotext 0_main.pdf - | egrep -e '\\w\\w\\w+' | iconv -f ISO-8859-15 -t UTF-8 | wc -w"
            },
            "linux": {
                "command": "pdftotext 0_main.pdf - | egrep -e '\\w\\w\\w+' | iconv -f ISO-8859-15 -t UTF-8 | wc -w"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": false
            },
            "problemMatcher": []
        }
    ]
}