{
	"folders": [
		{
			"name": "Dissertation",
			"path": "."
		}
	],
	"settings": {
		"editor.tabSize": 4,
		"editor.insertSpaces": true,
		"files.autoSave": "onFocusChange",

		"latex-workshop.formatting.latex": "latexindent",
		"latex-workshop.latex.autoBuild.run": "onSave",
		"latex-workshop.message.warning.show": false,
		"latex-workshop.message.error.show": false,
        "latex-workshop.view.pdf.invert": 0,
        
        "latex-workshop.latex.recipe.default": "pdflatex",
        "latex-workshop.latex.tools": [
            {
                "name": "latexmk",
                "command": "latexmk",
                "args": [
                    "-synctex=1",
                    "-interaction=nonstopmode",
                    "-file-line-error",
                    "-pdf",
                    "-outdir=%OUTDIR%",
                    "-auxdir=%AUXDIR%",
                    "%DOC%"
                ]
            },
            {
                "name": "pdflatex",
                "command": "pdflatex",
                "args": [
                    "-synctex=1",
                    "-interaction=nonstopmode",
                    "-file-line-error",
                    "%DOC%"
                ]
            },
            {
                "name": "bibtex",
                "command": "bibtex",
                "args": [
                    "%DOCFILE%"
                ]
            },
            {
                "name": "authortex",
                "command": "python",
                "args": [
                    "${workspaceFolder}/../../../utils/f_1_fix_authors.py",
                    "${file}"
                ]
            }
        ],
        "latex-workshop.latex.recipes": [
            {
                "name": "authortex -> pdflatex -> bibtex -> pdflatex*2",
                "tools": [
                    "fixauthors",
                    "pdflatex",
                    "bibtex",
                    "pdflatex",
                    "pdflatex"
                ]
            },
            {
                "name": "pdflatex",
                "tools": [
                "pdflatex"
                ]
            }
        ],

        "highlight.regexes": {
            "(\\\\todo){": {
                "filterFileRegex": ".*\\.tex$",
                "decorations": [
                    {
                        "backgroundColor": "yellow",
                        "fontWeight": "bold"
                    }
                ]
            }
        },
        "statusbar_command.commands": [
            {
                "text": "TeX Words: $(pencil)",
                "command": "workbench.action.tasks.runTask",
                "arguments": ["Count tex words"],
                "alignment": "right",
                "priority": 100
            }
        ]
	}
}