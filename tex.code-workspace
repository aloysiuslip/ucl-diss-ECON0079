{
	"folders": [
		{
			"name": "Dissertation",
			"path": "."
		}
	],
	"settings": {
		"editor.tabSize": 4,
		"editor.insertSpaces": true,
		"files.autoSave": "onFocusChange",

		"latex-workshop.formatting.latex": "latexindent",
		"latex-workshop.latex.autoBuild.run": "onSave",
		"latex-workshop.message.warning.show": false,
		"latex-workshop.message.error.show": false,
        "latex-workshop.view.pdf.invert": 1,
        
        "latex-workshop.latex.recipe.default": "pdflatex",
        "latex-workshop.latex.tools": [
            {
                "name": "latexmk",
                "command": "latexmk",
                "args": [
                    "-synctex=1",
                    "-interaction=nonstopmode",
                    "-file-line-error",
                    "-pdf",
                    "-outdir=%OUTDIR%",
                    "-auxdir=%AUXDIR%",
                    "%DOC%"
                ]
            },
            {
                "name": "pdflatex",
                "command": "pdflatex",
                "args": [
                    "-synctex=1",
                    "-interaction=nonstopmode",
                    "-file-line-error",
                    "%DOC%"
                ]
            },
            {
                "name": "bibtex",
                "command": "bibtex",
                "args": [
                    "%DOCFILE%"
                ]
            },
            {
                "name": "authortex",
                "command": "python",
                "args": [
                    "${workspaceFolder}/../../../utils/f_1_fix_authors.py",
                    "${file}"
                ]
            },
            {
                "name": "wordcount",
                "command": "powershell",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}/../../../utils/f_2_wordcount.ps1"
                ]
            }
        ],
        "latex-workshop.latex.recipes": [
            {
                "name": "wordcount -> authortex -> pdflatex -> bibtex -> pdflatex*2",
                "tools": [
                    "wordcount",
                    "authortex",
                    "pdflatex",
                    "bibtex",
                    "pdflatex",
                    "pdflatex"
                ]
            },
            {
                "name": "pdflatex",
                "tools": [
                "pdflatex"
                ]
            }
        ],

        "ltex.enabled": ["latex"],
        "ltex.language": "en-GB",
        "ltex.disabledRules": {
            "en-GB": [
                "PASSIVE_VOICE",
                "OXFORD_SPELLING_Z_NOT_S",
                "EN_UNPAIRED_QUOTES"
            ]
        },
        "ltex.latex.commands": {
            "\\itx{}": "dummy",
            "\\wraptable{}{}{}": "ignore",
            "\\tablerefp{}": "dummy",
        },
        "ltex.latex.environments": {
            "align*": "ignore",
            "tabular": "ignore"
        },
        "ltex.dictionary": {
            "en-GB": [
                // Theory
                "conceptualisable",
                "recreatable",
                "TFP-only",
                "TFP-spillover",
                "babyfather",
                "babymother",

                // Econometrics
                "endogeneity",
                "heteroskedasticity",
                "heteroskedastic",
                "homoskedasticity",
                "homoskedastic",
                "heteroscedasticity",
                "exogeneity",
                "multicollinearity",
                "multicollinear",
                "multicollinearities",
                "VARMA",
                "VAR",
                "autoregressor",
                "autoregressors",
                "unconfounded",
                "pre-multiplied",
                "overidentification",
                "underidentification",
                "overidentifying",
                "underidentifying",
                "overidentified",
                "underidentified",
                "GMM-CUE",

                // Set theory
                "irreflexive",
                "irreflexivity",

                // Data science
                "datapoint",             
                "datapoints",
                "timepoint",
                "timepoints",
                "filepaths",
                "DuckDB",
                "microdata",

                // Data
                "CPIH",
                "GVA",

                // # Names
                "Marshallian",
                "Nesheim"
            ]
        },

        "highlight.regexes": {
            "(\\\\todo){": {
                "filterFileRegex": ".*\\.tex$",
                "decorations": [
                    {
                        "backgroundColor": "yellow",
                        "fontWeight": "bold"
                    }
                ]
            }
        },
        "statusbar_command.commands": [
            {
                "text": "TeX Words: $(pencil)",
                "command": "workbench.action.tasks.runTask",
                "arguments": ["Count tex words"],
                "alignment": "right",
                "priority": 100
            }
        ]
	}
}